# ============================================================
# Coffret d'Amour — Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs
# ============================================================

# --- Général ---
NODE_ENV=development
PORT=3001

# --- Base de données ---
DATABASE_URL=postgresql://dev:dev@localhost:54330/coffret_amour

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- Authentification ---
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SHARED_CODE=14-02-2020-Marie
SHARED_PASSWORD=notre-coffret

# --- Stockage médias (Cloudflare R2 ou MinIO local) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=coffret-amour
S3_REGION=auto
S3_PUBLIC_URL=http://localhost:9000/coffret-amour

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite — préfixe VITE_) ---
VITE_API_URL=http://localhost:3001/v1
VITE_WS_URL=ws://localhost:3001

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Sentry ---
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Logtail ---
LOGTAIL_TOKEN=

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg
FFMPEG_MUSIC_PATH=./assets/music

# --- Puppeteer (exports PDF) ---
PUPPETEER_EXECUTABLE_PATH=

# --- Couple (config initiale) ---
COUPLE_WELCOME_PHRASE=Bienvenue dans notre coffret, mon amour…
COUPLE_RELATIONSHIP_START=2020-02-14
COUPLE_ANNIVERSARY_DATE=2026-07-14
COUPLE_MIDNIGHT_MESSAGE=Chaque message ici est une promesse. Bienvenue dans notre avenir, mon cœur…
